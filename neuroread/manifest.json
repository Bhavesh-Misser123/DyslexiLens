{
  "manifest_version": 3,
  "name": "NeuroRead",
  "version": "1.0",
  "description": "Accessibility tool for dyslexia: Readability fonts, focus ruler, TTS, and AI simplification.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}